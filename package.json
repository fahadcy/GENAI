{
  "name": "genai",
  "version": "1.0.0",
  "private": true,
  "description": "GenAI \u2014 one governed loop from brief to result. GenAI marketing automation platform.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "seed:easyliquidation": "tsx --conditions=react-server scripts/seed-easyliquidation.ts",
    "db:reset": "tsx --conditions=react-server scripts/reset.ts",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "setup": "npm run db:push && npm run db:seed",
    "worker": "tsx --conditions=react-server scripts/worker.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^5.9.6",
    "lucide-react": "^0.474.0",
    "nanoid": "^5.0.9",
    "next": "^16.3.2",
    "openai": "^4.80.1",
    "postgres": "^3.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^2.15.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.62.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.700.0"
  }
}
