# Copy this file to .env.local and fill in the two required values.
#
# Comments live on their own lines. Trailing comments after a value are handled
# correctly, but keeping them separate means a stray one can never be mistaken
# for part of a connection string or a model name.

# ---------------------------------------------------------------- required

# Any Postgres 14+. Neon, Supabase, RDS and Vercel Postgres all work.
# Neon: Console -> your project -> Connect -> Copy snippet. Paste it whole,
# including the ?sslmode=... on the end.
DATABASE_URL="postgres://user:password@host:5432/aurea"

# Signs session cookies. Generate one with: openssl rand -base64 32
# On Windows PowerShell:
#   $b = New-Object byte[] 32
#   [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   [Convert]::ToBase64String($b)
AUTH_SECRET="change-me-to-a-long-random-string-min-24-chars"

# ---------------------------------------------------------------- AI layer

# openai | anthropic | mock
AI_PROVIDER="openai"

# Leave this blank to run the deterministic simulator: every screen, score and
# recommendation still works, with zero model spend.
OPENAI_API_KEY=""

# Set for Azure OpenAI or a proxy.
# OPENAI_BASE_URL=""

# Two tiers, because most model calls in this platform are cheap high-volume
# work (scoring every variant, classifying, short loops) and only a few are
# worth a frontier model (writing campaigns, planning, reading an audience
# description). Running everything on the expensive tier costs a lot for no
# gain in the places it does not matter.

# Scoring, classification and cheap loops.
AI_MODEL_FAST="gpt-5.6-luna"

# Generation, planning, campaign building and segment interpretation.
AI_MODEL_SMART="gpt-5.5"

AI_MODEL_IMAGE="gpt-image-2"

# ANTHROPIC_API_KEY=""

# ------------------------------------------------------------ Google Ads

# All four of these are needed before anything reaches Google. Without them the
# platform runs its built-in campaign builder and checker: campaigns are built,
# validated against Google's real rules, reviewed and approved exactly as they
# would be, and every push is recorded and labelled as simulated. Nothing is
# ever reported as live when it was not.
#
# How to get them:
#
#   1. A Google Ads MANAGER account (an MCC). A normal Ads account cannot issue
#      a developer token.
#   2. In that manager account: Tools -> API Center -> apply for a developer
#      token. Google reviews this by hand. Expect a few working days, and start
#      it early — it is the long pole.
#      A "test" level token can only touch test accounts. You need at least
#      Basic access before it will work on a real one.
#   3. In Google Cloud Console: create an OAuth 2.0 client (type: Desktop app)
#      for the scope https://www.googleapis.com/auth/adwords, then complete the
#      consent flow once to obtain a refresh token.

GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_REFRESH_TOKEN=""

# The manager account that owns the token, digits only, no dashes.
# Sent to Google as login-customer-id when acting on a client account.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

# ------------------------------------------------------- social publishing

# LinkedIn. Create an app at https://developer.linkedin.com/ , associate it with
# a company page you administer, and add this exact redirect URL:
#   http://localhost:3000/api/connect/linkedin/callback
#
# Posting as a PERSON works immediately — the "Sign In with LinkedIn using
# OpenID Connect" and "Share on LinkedIn" products are self-serve.
#
# Posting as a COMPANY PAGE needs the Community Management API, which LinkedIn
# reviews by hand. Reported waits run from four weeks to six months, and vague
# applications are rejected — name the exact endpoints you will call and what
# you do with each. Apply early; the code works the moment it is granted.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Facebook Pages. Create an app at https://developers.facebook.com/ , add
# Facebook Login, and set this exact redirect URL:
#   http://localhost:3000/api/connect/facebook/callback
#
# Facebook does not permit posting to personal profiles at all — only Pages.
# While the app is in development you can post to Pages administered by people
# listed on the app itself, which is enough to test end to end. Posting to a
# client's Page needs App Review (pages_manage_posts, pages_read_engagement,
# pages_show_list) plus Business Verification.
META_APP_ID=""
META_APP_SECRET=""

# NOTE: APP_URL below must match the redirect URLs registered above, exactly,
# including the scheme and port. A mismatch is the most common cause of a
# connection failing with an unhelpful error.

# ------------------------------------------------------ email and SMS

# SendGrid sends the email. Without a key the platform still builds, approves
# and "sends" campaigns through its simulator, and labels them as simulated —
# nothing is ever reported as delivered when it was not.
#
#   1. Sign up at https://sendgrid.com/ (the free tier is 100 emails a day).
#   2. Settings -> API Keys -> Create API Key. Restricted Access is fine, but
#      it MUST have Mail Send permission. A read-only key fails with exactly
#      the same 401 as a wrong one, which is a miserable hour to lose.
#   3. Settings -> Sender Authentication. SendGrid refuses to send from an
#      address it has not verified. Verifying a single sender takes two minutes
#      and one confirmation email; authenticating the whole domain takes a few
#      DNS records and gets far better inbox placement.
SENDGRID_API_KEY=""

# Must be the address you verified above, or every send fails with a 403.
SENDGRID_FROM_EMAIL=""

# The name recipients see in their inbox, e.g. "CY Group".
SENDGRID_FROM_NAME=""

# ClickSend sends the texts. Same rule: no credentials, no real sends.
#
#   1. Sign up at https://www.clicksend.com/ and add credit — SMS is charged
#      per message, and a send with no balance fails outright.
#   2. Dashboard -> Developers -> API Credentials.
#   3. CLICKSEND_USERNAME is the account USERNAME shown there, which is often
#      not the email address you log in with.
CLICKSEND_USERNAME=""
CLICKSEND_API_KEY=""

# Optional sender ID. Leave blank to use the account default.
#
# An alphanumeric ID like "CYGROUP" looks better but CANNOT receive replies,
# so the platform drops "Reply STOP" from the message and relies on the other
# opt-out routes. A numeric ID can receive replies, so STOP is added
# automatically. Alphanumeric sender IDs are permitted in the UK but not in
# the US or Canada.
CLICKSEND_SENDER_ID=""

# ------------------------------------------------------- website / blog

# Publishing approved blog posts to your own WordPress site. No plugin is
# needed — the REST API and Application Passwords are both built into
# WordPress (5.6 and later). Without these, blog posts are written and
# approved in Aurea but recorded as simulated rather than published.
#
#   1. WORDPRESS_URL is the site address. If WordPress lives in a subfolder,
#      include it — https://example.co.uk/blog — or the API is not found.
#      The site must be on HTTPS: WordPress refuses Application Passwords
#      over plain http.
#   2. WORDPRESS_USERNAME is the WordPress USERNAME, not the email address.
#      The account needs the Author or Editor role. Subscriber and
#      Contributor can log in but cannot publish, which fails later and more
#      confusingly than a wrong password.
#   3. In WordPress: Users -> Profile -> scroll to Application Passwords ->
#      type a name like "Aurea" -> Add New Application Password. Copy the
#      generated password (it is shown once). Paste it here exactly as shown,
#      spaces and all — they are handled.
WORDPRESS_URL=""
WORDPRESS_USERNAME=""
WORDPRESS_APP_PASSWORD=""

# draft | publish
#
# "draft" (the default) means an approved post is created on the site as a
# draft for someone to look at and publish. Approval in Aurea was given to
# text in a preview pane; what your theme does with that text is a separate
# question, and worth seeing once.
#
# Change this to "publish" after the first post renders correctly and
# approved posts will go live with no further step.
WORDPRESS_POST_STATUS="draft"

# ------------------------------------------------- competitor intelligence
#
# Every source below is optional and independent. With none set, Competitors
# still works: discovery and every source with no key fall back to a
# simulator, and the screen labels each simulated item as simulated. Reading
# competitors' own public websites and blog feeds needs no key at all, so a
# competitor you add by its web address is analysed from real pages either way.

# Companies House: find your company on the register and its SIC codes, and
# list active companies with the same SIC code. Free. Register an application
# at https://developer.company-information.service.gov.uk/ and create a REST
# API key. Limit: 600 requests per 5 minutes.
COMPANIES_HOUSE_API_KEY=""

# Google Places API (New): businesses near your postcode and UK-wide, with
# website, rating and review count. In Google Cloud enable "Places API (New)"
# (not the legacy Places API), create an API key and restrict it to that API.
# Billed per request beyond the monthly free allowance.
GOOGLE_PLACES_API_KEY=""

# Search results. Any one of these three lets discovery find who ranks and who
# advertises on your searches. They differ in what they return:
#   DataForSEO  organic + paid ads with their copy, plus a keyword database
#               (shared keywords, a competitor's top keywords). Pay as you go,
#               $50 minimum deposit. https://dataforseo.com/  (login + API password)
#   SerpApi     organic + paid ads with their copy. 250 free searches a month.
#               https://serpapi.com/
#   Serper      organic results and news only, NO ads. 2,500 free searches.
#               https://serper.dev/
# If more than one is set, DataForSEO is used first, then SerpApi, then Serper.
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""
SERPAPI_API_KEY=""
SERPER_API_KEY=""

# YouTube Data API v3: a competitor's channel size and latest uploads. Free
# quota of 10,000 units a day. Google Cloud -> enable "YouTube Data API v3" ->
# create an API key.
YOUTUBE_API_KEY=""

# Whether to read competitors' public web pages and feeds. The reader obeys
# robots.txt, identifies itself, fetches a handful of pages per site and keeps
# extracts only, never whole pages. Set to "off" to rely on APIs alone.
COMPETITOR_CRAWL="on"

# How many days before a tracked competitor is scanned again by the worker.
COMPETITOR_RESCAN_DAYS="7"

# ------------------------------------------------------- budget allocator

# All optional. With none of these the Budget Allocator still works: plans,
# the allocator, pacing, statement CSV import, Airwallex (keys are entered per
# workspace on the Cards tab and stored encrypted) and the simulated market.

# TrueLayer Data API: read-only access to a company card through UK Open
# Banking. Create an app at console.truelayer.com and add the redirect URI
#   {APP_URL}/api/budget/truelayer/callback
# Going live needs an agency agreement under TrueLayer's AISP permission (or
# your own FCA registration) before TRUELAYER_ENV is set to "live".
TRUELAYER_CLIENT_ID=""
TRUELAYER_CLIENT_SECRET=""
TRUELAYER_ENV="sandbox"

# Model and video vendors bill in dollars; their costs land on the AI and video
# budget lines at this rate until a card charge says exactly what they cost.
BUDGET_USD_TO_GBP="0.79"

# ------------------------------------------------------------- commercial

# Optional. Without these the billing screens run in catalogue-only mode.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ------------------------------------------------------------------ misc

APP_URL="http://localhost:3000"

# Required in production to authorise the scheduled publish endpoint.
# CRON_SECRET=""


# ---------------------------------------------------------------------------
# Video generation
#
# With none of these set the platform runs the video simulator: real, playable
# clips with a burned-in label, generated with no vendor account and never
# billed. The whole governed loop — budget, guardrails, review, approval,
# audit — works exactly as it will with a provider key, which is why nothing
# has to be switched off to demonstrate it.
# ---------------------------------------------------------------------------

# google | runway | simulator
VIDEO_PROVIDER=simulator

# The fallback used when the primary is unreachable. Set it.
#
# This market moves faster than a procurement cycle: the model this feature was
# first specified against, OpenAI's sora-2, was announced for shutdown three
# weeks out with no replacement named. With a fallback configured, a notice
# like that is a config change rather than a project.
VIDEO_FALLBACK_PROVIDER=

# Google Veo, via the Gemini API. Model ids move while Veo is in preview —
# confirm against ai.google.dev/gemini-api/docs/veo before deploying.
GOOGLE_VIDEO_API_KEY=

# Runway, as the failover provider.
RUNWAY_API_KEY=

# Object storage for generated clips. Required in production: Veo deletes its
# own copy after 48 hours, so without ours the only artefact of an approved,
# published advertisement is gone inside two days. S3, Cloudflare R2,
# Backblaze B2 or MinIO — anything speaking the S3 API. Never make the bucket
# public; playback is served through short-lived signed URLs.
VIDEO_S3_ENDPOINT=
VIDEO_S3_REGION=eu-central-1
VIDEO_S3_BUCKET=
VIDEO_S3_ACCESS_KEY_ID=
VIDEO_S3_SECRET_ACCESS_KEY=

# How long a playback URL handed to a browser stays valid, in seconds.
VIDEO_SIGNED_URL_TTL_SECONDS=600

# How many video jobs the worker advances per workspace per tick. A generation
# holds the worker for minutes rather than milliseconds, so this cap is what
# stops one busy afternoon in the studio starving the publish queue.
VIDEO_MAX_JOBS_PER_TICK=6

# Where clips go when no S3 bucket is configured. Development only.
VIDEO_LOCAL_STORE_DIR=.aurea-video-store

# ── Growth agent ────────────────────────────────────────────────────
# The CRM and website connections are made on the Growth agent screen and
# stored encrypted per workspace. Lead finding uses COMPANIES_HOUSE_API_KEY
# above. The agent needs a model with tool calling; it uses AI_PROVIDER and
# its key, and this model if set (otherwise AI_MODEL_SMART, or a Claude model
# when AI_PROVIDER=anthropic). With no key it runs in simulated mode.
# AGENT_MODEL=""
